# Copy to .env and fill in. .env is gitignored and never reaches the browser.

# https://www.assemblyai.com/dashboard/api-keys
# Not needed in mock mode (ZABAAN_MOCK=1).
ASSEMBLYAI_API_KEY=

# Optional. When set, starting a voice call needs this passcode. Plain ASCII.
# Set it on any public deploy so strangers cannot spend your credits.
# DEMO_PASSCODE=

# Optional. 1 simulates scheduled app maintenance: app issue reports are told
# the app is under maintenance. Off unless set to 1.
# APP_MAINTENANCE=1
